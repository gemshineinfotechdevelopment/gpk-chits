PORT=5005
NODE_ENV=development

# Your frontend URL (comma-separated if multiple domains)
CLIENT_URL=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:8080

# Database
# If MongoDB is not running locally, server.js automatically falls back to in-memory MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/gpk_chit?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRE=7d

# Admin Credentials
ADMIN_EMAIL=admin@gpkcrackers.com
ADMIN_PASSWORD=admin321

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
